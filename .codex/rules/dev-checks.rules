prefix_rule(
    pattern = ["uv", "run", "ruff", "check", "."],
    decision = "allow",
    justification = "Repository-standard lint command.",
    match = [
        "uv run ruff check .",
    ],
    not_match = [
        "uv run ruff format .",
        "uv run python -m ruff check .",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "mypy", "src"],
    decision = "allow",
    justification = "Repository-standard type-check command.",
    match = [
        "uv run mypy src",
    ],
    not_match = [
        "uv run mypy tests",
        "python -m mypy src",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/unit", "-q"],
    decision = "allow",
    justification = "Repository-standard unit test command.",
    match = [
        "uv run pytest tests/unit -q",
    ],
    not_match = [
        "uv run pytest tests/unit",
        "uv run pytest tests/integration -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/correctness", "-q"],
    decision = "allow",
    justification = "Repository-standard correctness test command.",
    match = [
        "uv run pytest tests/correctness -q",
    ],
    not_match = [
        "uv run pytest tests/correctness",
        "uv run pytest tests/unit -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/artifacts", "-q"],
    decision = "allow",
    justification = "Repository-standard artefact test command.",
    match = [
        "uv run pytest tests/artifacts -q",
    ],
    not_match = [
        "uv run pytest tests/artifacts",
        "uv run pytest tests/monitoring -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/integration", "-m", "not gpu", "-q"],
    decision = "allow",
    justification = "Repository-standard integration test command for non-GPU runs.",
    match = [
        "uv run pytest tests/integration -m \"not gpu\" -q",
    ],
    not_match = [
        "uv run pytest tests/integration -q",
        "uv run pytest tests/integration -m gpu -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/kernels", "-m", "kernel", "-q"],
    decision = "allow",
    justification = "Repository-standard kernel test command.",
    match = [
        "uv run pytest tests/kernels -m kernel -q",
    ],
    not_match = [
        "uv run pytest tests/kernels -q",
        "uv run pytest tests/kernels -m gpu -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/monitoring", "-q"],
    decision = "allow",
    justification = "Repository-standard monitoring test command.",
    match = [
        "uv run pytest tests/monitoring -q",
    ],
    not_match = [
        "uv run pytest tests/monitoring",
        "uv run pytest tests/distributed -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/distributed", "-q"],
    decision = "allow",
    justification = "Repository-standard distributed failure-behaviour test command.",
    match = [
        "uv run pytest tests/distributed -q",
    ],
    not_match = [
        "uv run pytest tests/distributed",
        "uv run pytest tests/unit -q",
    ],
)

prefix_rule(
    pattern = ["uv", "run", "pytest", "tests/gpu", "tests/acceptance", "-m", "gpu", "-q"],
    decision = "allow",
    justification = "Repository-standard GPU and acceptance test command.",
    match = [
        "uv run pytest tests/gpu tests/acceptance -m gpu -q",
    ],
    not_match = [
        "uv run pytest tests/gpu tests/acceptance -q",
        "uv run pytest tests/gpu -m gpu -q",
    ],
)
